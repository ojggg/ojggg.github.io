---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const description = "백엔드와 서버 작업을 적는 기술 블로그.";
---

<Base title="JeongKeepsCalm" description={description}>
  <h1 class="display text-4xl tracking-tight text-zinc-900 md:text-6xl">글</h1>
  <p class="mt-4 max-w-[65ch] leading-relaxed text-zinc-600">{description}</p>
  <ul class="post-list mt-14 divide-y divide-line">
    {
      posts.map((post) => (
        <li class="py-8">
          <time
            class="font-mono text-xs tracking-wide text-zinc-500"
            datetime={post.data.pubDate.toISOString()}
          >
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          <a href={`/posts/${post.id}/`} class="mt-2 block">
            <span class="display text-2xl tracking-tight text-zinc-900 md:text-3xl">
              {post.data.title}
            </span>
          </a>
          <p class="mt-3 max-w-[65ch] leading-relaxed text-zinc-600">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
