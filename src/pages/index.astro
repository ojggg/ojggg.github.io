---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const description = "백엔드와 서버 작업을 적는 기술 블로그.";
---

<Base title="JeongKeepsCalm" description={description}>
  <h1 class="display text-3xl tracking-tight text-strong md:text-4xl">글</h1>
  <p class="mt-4 max-w-[65ch] leading-relaxed text-ink">{description}</p>
  <ul class="post-list mt-12 divide-y divide-line">
    {
      posts.map((post) => (
        <li>
          <time
            class="font-mono text-xs tracking-[0.14em] text-muted"
            datetime={post.data.pubDate.toISOString()}
          >
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          <a href={`/posts/${post.id}/`} class="mt-3 block">
            <span class="display text-2xl tracking-tight text-strong md:text-[1.75rem]">
              {post.data.title}
            </span>
          </a>
          <p class="mt-3 max-w-[65ch] leading-relaxed text-muted">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
