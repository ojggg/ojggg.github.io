---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const description = "백엔드와 서버 작업을 적는 기술 블로그.";
---

<Base title="JeongKeepsCalm" description={description}>
  <header class="index-head">
    <h1 class="display index-title">글</h1>
    <p class="index-dek">{description}</p>
  </header>
  <!--/* anchor: blog-index-post-list */-->
  {
    posts.length === 0 ? (
      <p class="empty-posts">아직 올린 글이 없다.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post, index) => (
          <li class="post-item" style={`--i: ${index}`}>
            <time
              class="post-date"
              datetime={post.data.pubDate.toISOString()}
            >
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
            <h2 class="display post-title">
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-dek">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
