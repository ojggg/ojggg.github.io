---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(`/posts/${post.id}/`, Astro.site).href;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = posts.findIndex((item) => item.id === post.id);
const newer = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const older =
  currentIndex >= 0 && currentIndex < posts.length - 1
    ? posts[currentIndex + 1]
    : undefined;

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Base
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
>
  <!--/* anchor: article-read-progress */-->
  <div class="read-progress" aria-hidden="true"></div>
  <article>
    <header class="article-head">
      <time class="article-date" datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      <h1 class="display article-title">{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>
    </header>
    <div class="prose article-body">
      <Content />
    </div>
    <!--/* anchor: article-adjacent-posts */-->
    <nav class="article-nav" aria-label="다른 글">
      {
        (older || newer) && (
          <div class="post-pager">
            {older && (
              <a class="pager-link" href={`/posts/${older.id}/`}>
                <time datetime={older.data.pubDate.toISOString()}>
                  {formatDate(older.data.pubDate)}
                </time>
                <span class="pager-title display">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a class="pager-link pager-newer" href={`/posts/${newer.id}/`}>
                <time datetime={newer.data.pubDate.toISOString()}>
                  {formatDate(newer.data.pubDate)}
                </time>
                <span class="pager-title display">{newer.data.title}</span>
              </a>
            )}
          </div>
        )
      }
      <a class="back-index" href="/">Posts</a>
    </nav>
  </article>
</Base>
