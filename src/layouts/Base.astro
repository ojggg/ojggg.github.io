---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: "website" | "article";
}

const { title, description, canonical, image, ogType = "website" } = Astro.props;
const site = Astro.site ?? new URL("https://ojggg.github.io");
const pageUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image ?? "/og-default.png", site).href;
const fullTitle = title === "JeongKeepsCalm" ? title : `${title} · JeongKeepsCalm`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="JeongKeepsCalm" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- google-site-verification: content 값은 서치 콘솔에서 받은 토큰으로 채운다 -->
    <!-- naver-site-verification: content 값은 서치어드바이저에서 받은 토큰으로 채운다 -->
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="min-h-dvh antialiased">
    <div class="page-shell">
      <header class="site-header">
        <a href="/" class="display wordmark">JeongKeepsCalm</a>
        <!--/* anchor: header-title-search */-->
        <div class="header-tools">
          <form class="title-search" action="/" method="get" role="search">
            <label for="title-query">Title</label>
            <input
              id="title-query"
              name="q"
              type="search"
              autocomplete="off"
              enterkeyhint="search"
            />
          </form>
          {
            ogType === "article" && (
              <a href="/" class="index-link">Posts</a>
            )
          }
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <span class="display footer-name">JeongKeepsCalm</span>
        <p>백엔드와 서버 작업을 적는 기술 블로그.</p>
      </footer>
    </div>
  </body>
</html>
